{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shawndale-glitch/demoshark/schema/walkthrough.schema.json",
  "title": "DEMOShark walk-through spec",
  "type": "object",
  "required": ["demoshark", "walkthrough", "app", "steps"],
  "additionalProperties": false,
  "$defs": {
    "text": {
      "description": "A plain string (same in every language) or one string per language code.",
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1},
         "propertyNames": {"pattern": "^[a-z]{2}(-[A-Z]{2})?$"}}
      ]
    },
    "target": {
      "description": "How a person would find the control: by role and visible name, by label, by placeholder or by text. Never CSS or XPath (DS4).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string"},
        "name": {"$ref": "#/$defs/text"},
        "label": {"$ref": "#/$defs/text"},
        "placeholder": {"$ref": "#/$defs/text"},
        "text": {"$ref": "#/$defs/text"},
        "within": {"$ref": "#/$defs/target"}
      },
      "anyOf": [
        {"required": ["role"]}, {"required": ["label"]}, {"required": ["placeholder"]}, {"required": ["text"]}
      ]
    }
  },
  "properties": {
    "demoshark": {"const": 1},
    "walkthrough": {
      "type": "object",
      "required": ["id", "title", "summary", "version", "environment", "languages"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "title": {"$ref": "#/$defs/text"},
        "summary": {"$ref": "#/$defs/text"},
        "audience": {"type": "string"},
        "owner": {"type": "string"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "environment": {"type": "string"},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"}}
      }
    },
    "app": {
      "type": "object",
      "required": ["name", "base_url"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "base_url": {"type": "string", "pattern": "^https?://"},
        "lang_param": {"type": "string"},
        "adapter": {"type": "string"},
        "viewport": {"type": "object", "properties": {"width": {"type": "integer"}, "height": {"type": "integer"}}}
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {"enum": ["auto", "edge", "sapi", "none"]},
        "preset": {"enum": ["smooth", "warm-male", "bright"]},
        "pitch": {"type": "string", "pattern": "^[+-]\\d+Hz$"},
        "voices": {"type": "object", "additionalProperties": {"type": "string"}},
        "rate": {"type": "string", "pattern": "^[+-]\\d+%$"}
      }
    },
    "fixtures": {"type": "object", "additionalProperties": {"type": "object"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "say", "do"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^S\\d+$"},
          "say": {"$ref": "#/$defs/text"},
          "result": {"$ref": "#/$defs/text"},
          "do": {
            "type": "object",
            "required": ["action"],
            "additionalProperties": false,
            "properties": {
              "action": {"enum": ["open", "click", "fill", "select", "press", "wait"]},
              "path": {"type": "string"},
              "target": {"$ref": "#/$defs/target"},
              "value": {"$ref": "#/$defs/text"},
              "key": {"type": "string"},
              "seconds": {"type": "number", "minimum": 0, "maximum": 10}
            }
          },
          "expect": {
            "type": "object",
            "required": ["target"],
            "additionalProperties": false,
            "properties": {
              "target": {"$ref": "#/$defs/target"},
              "value": {"$ref": "#/$defs/text"},
              "visible": {"type": "boolean"}
            }
          }
        }
      }
    },
    "verify": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fixture", "field"],
        "additionalProperties": false,
        "properties": {
          "fixture": {"type": "string"},
          "field": {"type": "string"},
          "equals": {},
          "filled": {"type": "boolean"}
        }
      }
    },
    "outputs": {"type": "array", "items": {"enum": ["video", "deck", "guide"]}, "uniqueItems": true}
  }
}
